{
  "$defs": {
    "digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "id": {
      "pattern": "^urn:uuid:[0-9a-f-]{36}$",
      "type": "string"
    }
  },
  "$id": "m2.publication-claim@0.1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "edition"
          }
        }
      },
      "then": {
        "required": [
          "work_id",
          "language",
          "translation_authority"
        ]
      }
    }
  ],
  "properties": {
    "basis": {
      "minLength": 1,
      "type": "string"
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "identity_status": {
      "const": "claimed"
    },
    "kind": {
      "enum": [
        "work",
        "edition"
      ]
    },
    "language": {
      "const": "zh-Hans"
    },
    "review_status": {
      "const": "in_review"
    },
    "rights": {
      "const": "unknown"
    },
    "schema": {
      "const": "m2.publication-claim@0.1.0"
    },
    "title_claim": {
      "minLength": 1,
      "type": "string"
    },
    "translation_authority": {
      "const": "unknown"
    },
    "work_id": {
      "$ref": "#/$defs/id"
    }
  },
  "required": [
    "schema",
    "id",
    "kind",
    "title_claim",
    "identity_status",
    "basis",
    "review_status",
    "rights"
  ],
  "type": "object"
}
