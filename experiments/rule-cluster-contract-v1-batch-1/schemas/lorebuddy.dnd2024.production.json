{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lorebuddy:research:dnd2024:production-contract:1",
  "title": "Finite D&D2024 production contract v1; not platform Core",
  "$defs": {
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_evidence_id",
        "source_entry_id",
        "source_note_utf8_range",
        "mapping_rule_id",
        "adopted_decision_ids"
      ],
      "properties": {
        "source_evidence_id": {
          "type": "string",
          "pattern": "^urn:uuid:[0-9a-f-]{36}$"
        },
        "source_entry_id": {
          "type": "string",
          "pattern": "^urn:uuid:[0-9a-f-]{36}$"
        },
        "mapping_rule_id": {
          "type": "string",
          "pattern": "^urn:uuid:[0-9a-f-]{36}$"
        },
        "adopted_decision_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^urn:uuid:[0-9a-f-]{36}$"
          }
        },
        "source_note_utf8_range": {
          "type": "object",
          "required": [
            "start",
            "end"
          ],
          "additionalProperties": false,
          "properties": {
            "start": {
              "type": "integer",
              "minimum": 0
            },
            "end": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "fact": {
      "type": "object",
      "required": [
        "state",
        "value",
        "binding"
      ],
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "known",
            "unknown",
            "not_stated",
            "not_applicable",
            "requires_runtime",
            "verbatim_only",
            "partially_structured"
          ]
        },
        "value": {},
        "binding": {
          "$ref": "#/$defs/binding"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "known"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "not": {
                  "type": "null"
                }
              }
            }
          }
        }
      ]
    },
    "spellcontract": {
      "type": "object",
      "required": [
        "base_level",
        "activation",
        "range",
        "targeting",
        "components",
        "duration",
        "concentration",
        "save_attack",
        "upcast",
        "effects",
        "coverage"
      ],
      "additionalProperties": false,
      "properties": {
        "base_level": {
          "$ref": "#/$defs/fact"
        },
        "activation": {
          "$ref": "#/$defs/fact"
        },
        "range": {
          "$ref": "#/$defs/fact"
        },
        "targeting": {
          "$ref": "#/$defs/fact"
        },
        "duration": {
          "$ref": "#/$defs/fact"
        },
        "concentration": {
          "$ref": "#/$defs/fact"
        },
        "save_attack": {
          "$ref": "#/$defs/fact"
        },
        "upcast": {
          "$ref": "#/$defs/fact"
        },
        "components": {
          "type": "object",
          "required": [
            "verbal",
            "somatic",
            "material",
            "material_detail",
            "material_consumption",
            "material_value"
          ],
          "additionalProperties": false,
          "properties": {
            "verbal": {
              "$ref": "#/$defs/fact"
            },
            "somatic": {
              "$ref": "#/$defs/fact"
            },
            "material": {
              "$ref": "#/$defs/fact"
            },
            "material_detail": {
              "$ref": "#/$defs/fact"
            },
            "material_consumption": {
              "$ref": "#/$defs/fact"
            },
            "material_value": {
              "$ref": "#/$defs/fact"
            }
          }
        },
        "effects": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/fact"
          }
        },
        "coverage": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "call": {
      "type": "object",
      "required": [
        "spell_id",
        "mode",
        "mapping_adoption_ids",
        "cast_level",
        "parameter_owner",
        "casting_ability",
        "save_dc",
        "spell_attack_bonus",
        "components_waived",
        "concentration_override",
        "target_override",
        "availability",
        "uncompiled_qualifications"
      ],
      "additionalProperties": false,
      "properties": {
        "cast_level": {
          "$ref": "#/$defs/fact"
        },
        "parameter_owner": {
          "$ref": "#/$defs/fact"
        },
        "casting_ability": {
          "$ref": "#/$defs/fact"
        },
        "save_dc": {
          "$ref": "#/$defs/fact"
        },
        "spell_attack_bonus": {
          "$ref": "#/$defs/fact"
        },
        "components_waived": {
          "$ref": "#/$defs/fact"
        },
        "concentration_override": {
          "$ref": "#/$defs/fact"
        },
        "target_override": {
          "$ref": "#/$defs/fact"
        },
        "availability": {
          "$ref": "#/$defs/fact"
        },
        "uncompiled_qualifications": {
          "$ref": "#/$defs/fact"
        },
        "spell_id": {
          "type": "string",
          "pattern": "^urn:uuid:[0-9a-f-]{36}$"
        },
        "mode": {
          "enum": [
            "intrinsic_spell_call",
            "stored_spell_instance"
          ]
        },
        "mapping_adoption_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^urn:uuid:[0-9a-f-]{36}$"
          }
        }
      }
    },
    "ability": {
      "type": "object",
      "required": [
        "id",
        "owner_id",
        "title",
        "verbatim_text",
        "critical_fields",
        "mechanics",
        "extensions",
        "source_evidence_id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^urn:uuid:[0-9a-f-]{36}$"
        },
        "owner_id": {
          "type": "string",
          "pattern": "^urn:uuid:[0-9a-f-]{36}$"
        },
        "source_evidence_id": {
          "type": "string",
          "pattern": "^urn:uuid:[0-9a-f-]{36}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "verbatim_text": {
          "type": "string",
          "minLength": 1
        },
        "critical_fields": {
          "type": "object"
        },
        "mechanics": {
          "type": "object",
          "required": [
            "kind",
            "clauses",
            "dependencies"
          ]
        },
        "extensions": {
          "type": "object",
          "required": [
            "lorebuddy.dnd2024"
          ],
          "properties": {
            "lorebuddy.dnd2024": {
              "type": "object",
              "required": [
                "source_parameter_bindings"
              ],
              "properties": {
                "casting_calls": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/$defs/call"
                  }
                }
              }
            }
          }
        }
      }
    },
    "card": {
      "type": "object",
      "required": [
        "id",
        "title",
        "rule_context_id",
        "verbatim_text",
        "source_evidence_id",
        "header",
        "abilities",
        "candidate_revision",
        "extensions"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^urn:uuid:[0-9a-f-]{36}$"
        },
        "source_evidence_id": {
          "type": "string",
          "pattern": "^urn:uuid:[0-9a-f-]{36}$"
        },
        "rule_context_id": {
          "type": "string",
          "pattern": "^urn:uuid:[0-9a-f-]{36}$"
        },
        "verbatim_text": {
          "type": "string",
          "minLength": 1
        },
        "abilities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ability"
          }
        },
        "candidate_revision": {
          "type": "integer",
          "minimum": 1
        },
        "extensions": {
          "type": "object",
          "required": [
            "lorebuddy.dnd2024"
          ]
        }
      }
    },
    "spell": {
      "type": "object",
      "required": [
        "id",
        "alias",
        "verbatim_text",
        "source_evidence_id",
        "extensions"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^urn:uuid:[0-9a-f-]{36}$"
        },
        "source_evidence_id": {
          "type": "string",
          "pattern": "^urn:uuid:[0-9a-f-]{36}$"
        },
        "verbatim_text": {
          "type": "string",
          "minLength": 1
        },
        "extensions": {
          "type": "object",
          "required": [
            "lorebuddy.dnd2024"
          ],
          "properties": {
            "lorebuddy.dnd2024": {
              "type": "object",
              "required": [
                "casting_contract"
              ],
              "properties": {
                "casting_contract": {
                  "$ref": "#/$defs/spellcontract"
                }
              }
            }
          }
        }
      }
    }
  },
  "type": "object",
  "required": [
    "delivery_id",
    "format_revision",
    "schema_revision",
    "contract_id",
    "contract_revision",
    "cards",
    "spells",
    "shared_rules",
    "expressions",
    "relations",
    "clusters",
    "evidence",
    "sources",
    "mapping_rules",
    "compatibility",
    "delivery_policy"
  ],
  "properties": {
    "delivery_id": {
      "type": "string",
      "pattern": "^urn:uuid:[0-9a-f-]{36}$"
    },
    "format_revision": {
      "const": "lorebuddy.dnd2024.rule-cluster-contract-1"
    },
    "schema_revision": {
      "const": "1.0.0"
    },
    "contract_revision": {
      "const": "v1-r1"
    },
    "cards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/card"
      }
    },
    "spells": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/spell"
      }
    },
    "shared_rules": {
      "type": "array",
      "minItems": 1
    },
    "clusters": {
      "type": "array",
      "minItems": 1
    },
    "delivery_policy": {
      "type": "object",
      "properties": {
        "formal_rule_approval": {
          "const": false
        },
        "consumer_acceptance": {
          "const": "pending"
        }
      }
    }
  }
}
