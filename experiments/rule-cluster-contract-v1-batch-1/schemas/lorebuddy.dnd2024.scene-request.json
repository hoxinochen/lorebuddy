{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lorebuddy:research:dnd2024:scene-request:1",
  "title": "Finite D&D2024 scene/request exchange; batch cardinality is in the intake plan",
  "type": "object",
  "required": [
    "corpus_delivery_id",
    "format_revision",
    "instructions",
    "questions"
  ],
  "additionalProperties": false,
  "properties": {
    "corpus_delivery_id": {
      "type": "string",
      "pattern": "^urn:uuid:[0-9a-f-]{36}$"
    },
    "format_revision": {
      "const": "lorebuddy.dnd2024.scene-request-1"
    },
    "instructions": {
      "type": "string"
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "question",
          "request_scope",
          "scene",
          "delivery"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "request_scope": {
            "enum": [
              "damage_and_linked",
              "full_ability",
              "hp_settlement",
              "source_state_change",
              "instance_migration"
            ]
          },
          "delivery": {
            "type": "string"
          },
          "scene": {
            "type": "object",
            "required": [
              "roster",
              "event"
            ],
            "additionalProperties": false,
            "properties": {
              "roster": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "instance_id",
                    "prototype_id"
                  ],
                  "properties": {
                    "instance_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "prototype_id": {
                      "anyOf": [
                        {
                          "type": "string",
                          "pattern": "^urn:uuid:[0-9a-f-]{36}$"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  }
                }
              },
              "event": {
                "type": "object",
                "required": [
                  "actor_instance_id",
                  "declared_action_name",
                  "target_instance_ids",
                  "amount_mode"
                ],
                "properties": {
                  "actor_instance_id": {
                    "type": "string"
                  },
                  "declared_action_name": {
                    "type": "string"
                  },
                  "target_instance_ids": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string"
                    }
                  },
                  "amount_mode": {
                    "enum": [
                      "printed_fixed",
                      "recorded_roll"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
