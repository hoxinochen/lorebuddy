{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "core.source-artifact@0.1.0",
  "title": "LoreBuddy Source Artifact",
  "type": "object",
  "x-lorebuddy-version": "0.1.0",
  "x-lorebuddy-profile": "m1-profile@0.1.0",
  "additionalProperties": false,
  "required": ["schema", "id", "package_id", "original_filename", "size", "digest", "format", "acquisition", "access_status", "lifecycle"],
  "properties": {
    "schema": {"const": "core.source-artifact@0.1.0"},
    "id": {"$ref": "#/$defs/id"},
    "package_id": {"$ref": "#/$defs/id"},
    "original_filename": {"type": "string", "minLength": 1, "pattern": "^[^/\\\\]+$"},
    "size": {"type": "integer", "minimum": 1},
    "digest": {"$ref": "#/$defs/digest"},
    "format": {"enum": ["chm", "zip", "directory", "other"]},
    "acquisition": {
      "type": "object", "additionalProperties": false,
      "required": ["source_kind", "source_label"],
      "properties": {
        "source_kind": {"enum": ["user-provided", "local-file", "unknown"]},
        "source_label": {"type": "string", "minLength": 1}
      }
    },
    "access_status": {"enum": ["restricted", "private", "unknown"]},
    "lifecycle": {"$ref": "#/$defs/lifecycle"},
    "extensions": {"$ref": "#/$defs/extensions"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "lifecycle": {"type": "object", "additionalProperties": false, "required": ["status", "revision"], "properties": {"status": {"enum": ["draft", "active"]}, "revision": {"type": "integer", "minimum": 1}}},
    "extensions": {"type": "object", "propertyNames": {"pattern": "^[a-z][a-z0-9-]{1,63}$"}, "additionalProperties": {"type": "object"}}
  }
}
