{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "core.boundary-record@0.1.0",
  "title": "LoreBuddy Boundary Record",
  "type": "object",
  "x-lorebuddy-version": "0.1.0",
  "x-lorebuddy-profile": "m1-profile@0.1.0",
  "additionalProperties": false,
  "required": ["schema", "id", "artifact_id", "entry_id", "candidate_key", "locator", "proposed_title", "status", "node_id", "decision", "lifecycle"],
  "properties": {
    "schema": {"const": "core.boundary-record@0.1.0"},
    "id": {"$ref": "#/$defs/id"},
    "artifact_id": {"$ref": "#/$defs/id"},
    "entry_id": {"$ref": "#/$defs/id"},
    "candidate_key": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "locator": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "start", "end"],
      "properties": {"kind": {"enum": ["byte-range", "dom-event-range"]}, "start": {"type": "integer", "minimum": 0}, "end": {"type": "integer", "minimum": 1}}
    },
    "proposed_title": {"type": "string", "minLength": 1},
    "status": {"enum": ["proposed", "approved", "rejected"]},
    "node_id": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
    "decision": {
      "type": "object", "additionalProperties": false,
      "required": ["review_status", "reviewer_id", "reason"],
      "properties": {
        "review_status": {"enum": ["pending", "approved", "rejected"]},
        "reviewer_id": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "reason": {"type": ["string", "null"]}
      }
    },
    "lifecycle": {"$ref": "#/$defs/lifecycle"},
    "extensions": {"$ref": "#/$defs/extensions"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "approved"}}, "required": ["status"]},
      "then": {
        "properties": {
          "node_id": {"$ref": "#/$defs/id"},
          "decision": {
            "type": "object",
            "properties": {"review_status": {"const": "approved"}, "reviewer_id": {"$ref": "#/$defs/id"}},
            "required": ["review_status", "reviewer_id"]
          }
        }
      }
    }
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "lifecycle": {"type": "object", "additionalProperties": false, "required": ["status", "revision"], "properties": {"status": {"enum": ["draft", "active", "deprecated"]}, "revision": {"type": "integer", "minimum": 1}}},
    "extensions": {"type": "object", "propertyNames": {"pattern": "^[a-z][a-z0-9-]{1,63}$"}, "additionalProperties": {"type": "object"}}
  }
}
