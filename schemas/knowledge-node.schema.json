{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "core.knowledge-node@0.1.0",
  "title": "LoreBuddy M1 Knowledge Node Envelope",
  "type": "object",
  "x-lorebuddy-version": "0.1.0",
  "x-lorebuddy-profile": "m1-profile@0.1.0",
  "additionalProperties": false,
  "required": ["schema", "id", "package_id", "kind", "title", "language", "aliases", "content", "provenance", "relationship_ids", "lifecycle"],
  "properties": {
    "schema": {"const": "core.knowledge-node@0.1.0"},
    "id": {"$ref": "#/$defs/id"},
    "package_id": {"$ref": "#/$defs/id"},
    "kind": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$"},
    "title": {"type": "string", "minLength": 1},
    "language": {"type": "string", "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$"},
    "aliases": {
      "type": "array", "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["value", "language"],
        "properties": {"value": {"type": "string", "minLength": 1}, "language": {"type": "string", "minLength": 2}}
      }
    },
    "content": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "fidelity_target", "body_digest"],
      "properties": {
        "mode": {"const": "transcription"},
        "fidelity_target": {"const": "verbatim-visible-text"},
        "body_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "provenance": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "fragment_id", "role", "coverage", "source_mapping_ids"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "fragment_id": {"$ref": "#/$defs/id"},
          "role": {"enum": ["transcription", "translation", "evidence"]},
          "coverage": {"enum": ["full", "partial"]},
          "source_mapping_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true}
        }
      }
    },
    "relationship_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true},
    "lifecycle": {"$ref": "#/$defs/lifecycle"},
    "extensions": {"$ref": "#/$defs/extensions"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "lifecycle": {"type": "object", "additionalProperties": false, "required": ["status", "revision"], "properties": {"status": {"enum": ["draft", "active", "deprecated", "withdrawn"]}, "revision": {"type": "integer", "minimum": 1}}},
    "extensions": {"type": "object", "propertyNames": {"pattern": "^[a-z][a-z0-9-]{1,63}$"}, "additionalProperties": {"type": "object"}}
  }
}
